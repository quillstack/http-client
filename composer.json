{
    "name": "quillstack/http-client",
    "description": "An HTTP client based on PSR-18, over cURL, saying what went wrong and where.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "http",
        "client",
        "psr-18",
        "curl",
        "quillstack",
        "php8"
    ],
    "homepage": "https://quillstack.org/packages/http-client",
    "authors": [
        {
            "name": "Radek Ziemniewicz",
            "email": "radek@quillstack.org"
        }
    ],
    "require": {
        "ext-curl": "*",
        "php": "^8.1",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.0|^2.0",
        "quillstack/header-bag": "^0.6",
        "quillstack/response": "^0.7.1",
        "quillstack/stream": "^0.7.1",
        "quillstack/uri": "^0.6.4"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "quillstack/di": "^0.6",
        "quillstack/unit-tests": "^0.9"
    },
    "autoload": {
        "psr-4": {
            "Quillstack\\HttpClient\\": "src/",
            "Quillstack\\HttpClient\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "unit-tests",
        "test:coverage": "phpdbg -qrr ./vendor/bin/unit-tests",
        "stan": "phpstan analyse"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.6.x-dev"
        }
    }
}
